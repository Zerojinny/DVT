# DVT - aria2 settings for 100 Mbps (or slower) links
# Kept in <media>\config. startnet.cmd copies it to X:\restore and
# link.exe renames the template for the link speed to aria2.conf
file-allocation=none
seed-time=60
enable-dht=false
enable-peer-exchange=false
bt-enable-lpd=false
max-overall-download-limit=0
bt-max-peers=30
bt-request-peer-speed-limit=1M
max-upload-limit=8M
bt-tracker-interval=60
# Started when the download is complete (restore runs while seeding)
on-bt-download-complete=start_restore.bat
